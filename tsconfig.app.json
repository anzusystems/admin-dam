{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "src/typed-router.d.ts"],
  "exclude": ["src/auto-imports.d.ts", "src/**/__tests__/*", "src/test/**/*", "src/**/*.test.*", "src/**/*.spec.*", "dist"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "noUncheckedIndexedAccess": false,
    "types": ["vue-router/auto"]
  }
}
