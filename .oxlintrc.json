{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue"],
  "env": { "browser": true },
  "ignorePatterns": ["dist", "dist-ssr", "coverage", "e2e", "src/typed-router.d.ts", "src/auto-imports.d.ts"],
  "categories": { "correctness": "error" },
  "rules": {
    "no-unused-vars": ["error", { "caughtErrors": "none" }],
    "no-unused-expressions": "off",

    "no-var": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "typescript/no-array-constructor": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error",
    "vue/component-definition-name-casing": "error",
    "vue/no-multiple-slot-args": "error",
    "vue/no-required-prop-with-default": "error",
    "vue/prop-name-casing": "error",
    "vue/require-default-prop": "error",
    "vue/require-prop-types": "error",
    "vue/require-typed-ref": "error",

    // oxlint does not run prefer-const inside a .vue file at all, so handing it over
    // would switch it off for every SFC. Left to eslint, which does both.
    "prefer-const": "off",

    // These five resolve `computed`, `watch` and the lifecycle hooks through the import
    // statement. Auto-imports removed those imports, so oxlint's versions say nothing;
    // eslint's still work, because they also walk the globals from auto-import.
    "vue/no-async-in-computed-properties": "off",
    "vue/no-side-effects-in-computed-properties": "off",
    "vue/return-in-computed-property": "off",
    "vue/no-lifecycle-after-await": "off",
    "vue/no-watch-after-await": "off"
  }
}
