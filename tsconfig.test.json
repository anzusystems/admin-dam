{
  "extends": "./tsconfig.app.json",
  // `plugins.d.ts` is not decoration: it augments common-admin's `AssetFileProperties` with
  // `ttsAudio`, and nothing imports it by name. Reached-by-import alone leaves the augmentation out
  // and the program fails in `assetDetailStore.ts`, a file the tests never touch.
  "include": [
    "env.d.ts",
    "src/auto-imports.d.ts",
    "src/plugins.d.ts",
    "src/test/**/*",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vitest/globals", "node"],
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
