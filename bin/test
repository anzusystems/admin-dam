#!/bin/bash
# Script used to run the tests in the application container
#######################################################################################################################
# Default variables
#######################################################################################################################
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
ARGS="$*"
BROWSER="chrome"
ENV="local"
FILTER=""
TAG=""
RUNNER="yarn"
DASHBOARD_OPTIONS="--record false"
E2E_DIR="${PROJECT_ROOT}/e2e"
CONFIG_FILE="config/cypress.config.ts"
RUN_UNIT=true
RUN_E2E=true

cd "${PROJECT_ROOT}" || exit 1
# Initialize default variables
# shellcheck disable=SC1091
. ./bin/docker-libvariables
# Initialize functions
# shellcheck disable=SC1091
. ./bin/docker-libfunctions
docker_env_vars

function help() {
    echo -en "$(printf %q "${BASH_SOURCE[0]}") [OPERATION] [OPTIONS]...
    \nBash script used to run the tests: vitest over src/, and the Cypress e2e suite

    Options:
        --unit       (Optional) Run only the vitest suite (src/test), skip e2e
        --e2e        (Optional) Run only the Cypress e2e suite, skip vitest
        -e --env     (Optional) Environment of the project (Allowed values: local | dev | stg, Default: local)
        -b --browser (Optional) Browser for test execution (Allowed values: chrome | electron | firefox, Default: chrome)
        -f --filter  (Optional) Comma separated list of filters (Default: n/a - all tests)
        -t --tag     (Optional) Only for dashboard runs tags for cypress dashboard list
        -d           (Optional) Cypress dashboard run, results will be stored in dashboard as well as in 'e2e/report' folder

    Examples:
        $(printf %q "${BASH_SOURCE[0]}")
        $(printf %q "${BASH_SOURCE[0]}") --unit
        $(printf %q "${BASH_SOURCE[0]}") --e2e -e local -b chrome -f @datepicker,@nl --tag Docker,Web -d
    \n"
}

#######################################################################################################################
# Go through all command line arguments and setup variables accordingly
#######################################################################################################################
while [ "$#" -gt 0 ]; do
    case $1 in
    --unit)
        RUN_E2E=false
        shift 1
        continue
        ;;
    --e2e)
        RUN_UNIT=false
        shift 1
        continue
        ;;
    -b)
        BROWSER=$2
        shift; shift
        continue
        ;;
    --browser*)
        BROWSER=${1#*=}
        shift 1
        continue
        ;;
    -e)
        ENV=$2
        shift; shift
        continue
        ;;
    --env*)
        ENV=${1#*=}
        shift 1
        continue
        ;;
    -f)
        FILTER=$2
        shift; shift
        continue
        ;;
    --filter*)
        FILTER=${1#*=}
        shift 1
        continue
        ;;
    -t)
        TAG=$2
        shift; shift
        continue
        ;;
    --tag*)
        TAG=${1#*=}
        shift 1
        continue
        ;;
    -d)
        DASHBOARD_OPTIONS="--record --tag ${ENV},${TAG},${FILTER}"
        shift 1
        continue
        ;;
    *)
        echo "[WARN] Unknown command line switch: $1"
        help
        exit 1
        ;;
    esac
done

if [ "${RUN_UNIT}" = "false" ] && [ "${RUN_E2E}" = "false" ]; then
    echo "[ERROR] '--unit' and '--e2e' select a single suite each; passing both leaves nothing to run"
    help
    exit 1
fi

if [ -n "${BROWSER}" ] && [[ ! ${BROWSER} =~ ^electron$|^chrome$|^firefox$ ]]; then
    echo "[ERROR] Invalid value: '${BROWSER}' using '-b, --browser' option"
    help
    exit 1
fi

if [ -n "${ENV}" ] && [ ! -f "e2e/config/${ENV}.ts" ] || [[ ! ${ENV} =~ ^stg$|^dev$|^local$ ]]; then
    echo "[ERROR] Config file '${ENV}.ts' does not exist in e2e/config folder"
    help
    exit 1
fi

if [ -f /.dockerenv ]; then
    STATUS=0

    # vitest first: it needs no environment and no browser, so its result is on screen within seconds.
    if [ "${RUN_UNIT}" = "true" ]; then
        echo "[INFO] yarn test"
        (cd "${PROJECT_ROOT}" && yarn test) || STATUS=1
    fi

    if [ "${RUN_E2E}" = "false" ]; then
        exit ${STATUS}
    fi

    # The e2e suite is its own yarn project, so cypress lives there, not in the app's
    # node_modules. Everything below runs from e2e/.
    cd "${E2E_DIR}" || exit 1
    yarn install || exit 1
    if [ ! -d "${CYPRESS_CACHE_FOLDER}" ] ; then
        ${RUNNER} cypress install --force
    fi
    # `--expose`, not `--env` or `CYPRESS_grepTags`: Cypress 16 removed `Cypress.env()`, so
    # everything the specs read in the browser goes through `expose`.
    #
    # One `--expose`, never two: the CLI option carries no collector, so a second occurrence
    # replaces the first. Pairs are comma separated, which is why a filter's own commas become
    # spaces -- `@a @b` is @cypress/grep's OR, and a comma there would be read as a pair boundary.
    EXPOSE="cfg=${ENV}"
    [ -n "${FILTER}" ] && EXPOSE="${EXPOSE},grepTags=${FILTER//,/ }"
    # shellcheck disable=SC2086
    dbus-launch ${RUNNER} cypress run \
        --config-file ${CONFIG_FILE} \
        --expose "${EXPOSE}" \
        --browser ${BROWSER} \
        ${DASHBOARD_OPTIONS} || STATUS=1
    exit ${STATUS}
fi

bin/docker-compose exec --user node "${DOCKER_COMPOSE_SERVICE_NAME}" bash -c \'bin/test "${ARGS}"\'
