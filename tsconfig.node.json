{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*"
  ],
  "compilerOptions": {
    "noEmit": true,
    // The Vite configs import their shared options by their real `.mts` path, because that is the
    // only specifier Node resolves under `configLoader: 'native'`.
    "allowImportingTsExtensions": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
