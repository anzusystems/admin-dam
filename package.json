{
  "name": "adam-admin",
  "packageManager": "yarn@4.18.1",
  "license": "Apache-2.0",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --minify false",
    "production": "vite build --mode production",
    "development": "vite build --mode development --sourcemap",
    "preview": "vite preview",
    "lint": "[ \"$*\" = \"--fix\" ] && yarn lint:fix || yarn ci",
    "lint:fix": "run-s --print-name generate:dts lint:oxlint:fix lint:eslint:fix lint:stylelint:fix format",
    "lint:tsc": "NODE_OPTIONS=--max-old-space-size=4096 vue-tsc --build",
    "generate:dts": "node scripts/generate-dts.mjs",
    "ci": "run-s --print-name generate:dts ci:checks",
    "ci:checks": "run-p --aggregate-output --continue-on-error --print-label --silent ci:lint test",
    "ci:lint": "run-p --aggregate-output --continue-on-error --print-label --silent lint:tsc format:check lint:oxlint lint:eslint lint:stylelint",
    "lint:oxlint": "oxlint . --disable-nested-config",
    "lint:oxlint:fix": "oxlint . --fix --disable-nested-config",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "lint:stylelint": "stylelint src/**/*.{scss,vue}",
    "lint:stylelint:fix": "stylelint src/**/*.{scss,vue} --fix",
    "format": "oxfmt --disable-nested-config src scripts eslint.config.mjs env.d.ts vite.config.mts vitest.config.mts",
    "format:check": "oxfmt --disable-nested-config src scripts eslint.config.mjs env.d.ts vite.config.mts vitest.config.mts --check",
    "browserslist:update": "npx --yes update-browserslist-db@latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "release:start": "npx -y --allow-git=all github:anzusystems/release-tools#main start",
    "release:publish": "npx -y --allow-git=all github:anzusystems/release-tools#main publish",
    "release:cleanup": "npx -y --allow-git=all github:anzusystems/release-tools#main cleanup"
  },
  "dependencies": {
    "@anzusystems/common-admin": "2.0.0-rc.4",
    "@floating-ui/dom": "^1.8.0",
    "@mdi/font": "7.4.47",
    "@sentry/vue": "^11.9.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vueuse/core": "15.0.0",
    "@vueuse/integrations": "15.0.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "jwt-decode": "^4.0.0",
    "linkifyjs": "^4.4.0",
    "pinia": "^4.1.0",
    "rusha": "^0.8.14",
    "sortablejs": "^1.15.7",
    "universal-cookie": "^8.1.2",
    "uuid": "^14.0.3",
    "vue": "3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@sentry/vite-plugin": "^11.9.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@types/rusha": "^0.8.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/ui": "^5.0.5",
    "@vue/devtools-api": "^8.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/language-server": "3.3.13",
    "@vue/tsconfig": "^0.9.1",
    "browserslist": "^4.29.5",
    "dotenv": "^18.0.9",
    "eslint": "10.13.0",
    "eslint-plugin-oxlint": "1.89.0",
    "eslint-plugin-pinia": "^0.4.2",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuetify": "^2.7.3",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "unplugin": "^3.5.0",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.13"
  }
}
