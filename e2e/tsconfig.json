{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@pages/*": ["./pages/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./pages"
    },
    {
      "path": "./tests"
    },
    {
      "path": "./tsconfig.setup.json"
    }
  ]
}
