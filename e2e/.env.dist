# Playwright environment config for admin-dam e2e tests
# Copy to .env.local, .env.devel or .env.staging and fill in values

# Target environment: local | devel | staging
ADAM_ENV=devel

# App base URL (no trailing slash)
BASE_URL=https://admin-dam.smedevel.sk

# Force-login URL for the test admin user — must end with the user id
FORCE_LOGIN_URL=https://core-dam.smedevel.sk/force/login/adm/

# Admin user ID
ADMIN_USER_ID=

# Optional — force-login user ids, one per parallel worker slot (worker 0 takes the first, and so
# on). Each must be an existing DAM super admin. Unset means a single worker running as ADMIN_USER_ID.
FORCE_LOGIN_USER_IDS=

# Domain (used for constructing external URLs: core-dam, prihlasenie, admin-cms, etc.)
URL_DOMAIN=smedevel.sk
URL_PROTO=https

# Licence every test runs under (100000 = Sme Family on devel)
LICENCE_ID=100000

# local only — Chromium pins every `*.localhost` host to 127.0.0.1 and ignores /etc/hosts. Remap the
# local hostnames to the Docker host. Leave unset on devel/staging. Example: MAP *.sme.localhost 172.17.0.1
HOST_RESOLVER_RULES=
