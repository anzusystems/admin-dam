{
  "name": "adam-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for ADAM using Playwright",
  "scripts": {
    "test:open": "playwright test --ui --config playwright.config.ts",
    "test:open:win": "playwright test --ui --ui-host=0.0.0.0 --ui-port=8080 --config playwright.config.ts",
    "test:run": "playwright test --config playwright.config.ts",
    "test:run:local": "ADAM_ENV=local playwright test --config playwright.config.ts",
    "test:run:devel": "ADAM_ENV=devel playwright test --config playwright.config.ts",
    "test:run:staging": "ADAM_ENV=staging playwright test --config playwright.config.ts",
    "lint": "yarn ci",
    "lint:fix": "yarn lint:oxlint:fix && yarn format",
    "lint:tsc": "tsc -b",
    "lint:oxlint": "oxlint . --disable-nested-config",
    "lint:oxlint:fix": "oxlint . --fix --disable-nested-config",
    "format": "oxfmt --disable-nested-config pages setup tests playwright.config.ts",
    "format:check": "oxfmt --disable-nested-config pages setup tests playwright.config.ts --check",
    "ci": "yarn lint:tsc && yarn format:check && yarn lint:oxlint"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "dotenv": "^18.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
