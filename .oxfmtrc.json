{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "singleAttributePerLine": true,
  "ignorePatterns": [
    "/*",
    "!/src",
    "!/scripts",
    "!/eslint",
    "!/*.mts",
    "!/*.mjs",
    "!/env.d.ts"
  ]
}
